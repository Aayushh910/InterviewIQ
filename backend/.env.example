APP_NAME="InterviewIQ API"
APP_ENV=development
DEBUG=True
DATABASE_URL=postgresql+psycopg://postgres:<YOUR_POSTGRES_PASSWORD>@localhost:5432/interviewiq
FRONTEND_URL=http://localhost:5173

FACE_LANDMARKER_MODEL_PATH=models/face_landmarker.task

FACIAL_ANALYSIS_SAMPLE_FPS=2
MAX_VIDEO_SIZE_MB=100
MAX_VIDEO_DURATION_SECONDS=300

# Speech-to-Text Provider Settings (groq, faster_whisper, mock)
STT_PROVIDER=groq
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo
STT_TIMEOUT_SECONDS=30.0
STT_MODEL_SIZE=tiny
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=en
# Text-to-Speech Provider Settings (mock, edge_tts, gtts)
TTS_PROVIDER=mock
TTS_API_KEY=
TTS_MODEL=default
TTS_VOICE=default
TTS_LANGUAGE=en
TTS_TIMEOUT_SECONDS=30.0


MAX_FOLLOW_UPS_PER_QUESTION=2
LLM_PROVIDER=local

EVALUATION_WEIGHT_RELEVANCE=0.20
EVALUATION_WEIGHT_CORRECTNESS=0.30
EVALUATION_WEIGHT_COMPLETENESS=0.20
EVALUATION_WEIGHT_CLARITY=0.15
EVALUATION_WEIGHT_TECHNICAL_DEPTH=0.15
EVALUATION_PROVIDER=heuristic

# AI Provider Settings (groq, mock, openai, heuristic)
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_SECONDS=15.0
