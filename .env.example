# ==============================================================================
# InterviewIQ — Unified Environment Configuration Template
# Copy this file to `backend/.env` (and optional `frontend/.env`) for local setup.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# ─── 1. Backend Core & Database ──────────────────────────────────────────────
APP_NAME="InterviewIQ API"
APP_ENV=development
DEBUG=True
DATABASE_URL=postgresql+psycopg://postgres:<YOUR_POSTGRES_PASSWORD>@localhost:5432/interviewiq
FRONTEND_URL=http://localhost:5173

# ─── 2. JWT Authentication Secrets ───────────────────────────────────────────
# Generate a secure 256-bit key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<YOUR_SECRET_KEY_HEX>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=4320

# ─── 3. AI & Groq Agent Configuration ─────────────────────────────────────────
# Production AI Provider (groq / mock)
AI_PROVIDER=groq
AI_API_KEY=<YOUR_GROQ_API_KEY>
AI_MODEL=openai/gpt-oss-120b
AI_TIMEOUT_SECONDS=20.0

# ─── 4. Speech-to-Text (STT) ──────────────────────────────────────────────────
# Providers: groq (recommended cloud), faster_whisper (local CPU/GPU), mock (testing)
STT_PROVIDER=groq
STT_API_KEY=<YOUR_GROQ_API_KEY>
STT_MODEL=whisper-large-v3-turbo
STT_TIMEOUT_SECONDS=30.0
STT_LANGUAGE=en

# ─── 5. Text-to-Speech (TTS) ──────────────────────────────────────────────────
# Providers: mock, edge_tts, gtts
TTS_PROVIDER=mock
TTS_API_KEY=
TTS_MODEL=default
TTS_VOICE=default
TTS_LANGUAGE=en
TTS_TIMEOUT_SECONDS=30.0

# ─── 6. Multimodal Face & Behavior Analysis (MediaPipe) ───────────────────────
FACE_LANDMARKER_MODEL_PATH=models/face_landmarker.task
MAX_FACES=4
MIN_FACE_DETECTION_CONFIDENCE=0.5
MIN_FACE_PRESENCE_CONFIDENCE=0.5
MIN_TRACKING_CONFIDENCE=0.5
FACIAL_ANALYSIS_SAMPLE_FPS=2.0
MAX_VIDEO_SIZE_MB=100
MAX_VIDEO_DURATION_SECONDS=300

# ─── 7. Interview Flow & Evaluation Configuration ────────────────────────────
MAX_FOLLOW_UPS_PER_QUESTION=2
LLM_PROVIDER=local
EVALUATION_PROVIDER=heuristic

# ─── 8. Frontend Environment Settings (frontend/.env) ────────────────────────
VITE_API_URL=http://localhost:8000/api/v1
